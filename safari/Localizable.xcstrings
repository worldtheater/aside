  "strings": {
    "Apple on-device translation requires macOS 26 or later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果本地翻译需要 macOS 26 或更新版本。"
          }
        }
      }
    },
    "The translation session ended. Retry to create a new session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译会话已结束，请重试以重新创建。"
