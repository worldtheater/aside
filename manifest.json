{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_description__",
  "version": "0.1.1",
  "homepage_url": "https://github.com/worldtheater/aside",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "favicon"
  ],
  "key": "",
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["lights.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "commands": {
    "switch-recent-tab": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "__MSG_switchRecentTab__"
    },
    "quick-question": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "__MSG_quickQuestion__"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
